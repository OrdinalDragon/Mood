# ============================================================
# MOOD - Variables de entorno (copiar a .env y completar)
# ============================================================
# Generá el secreto con: openssl rand -hex 32
# (si dejás el valor de ejemplo, el backend no arranca a propósito)
JWT_SECRET=change-me-in-production

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mood_user
MONGO_INITDB_ROOT_PASSWORD=cambiame
MONGO_INITDB_DATABASE=mood_db
MONGO_URI=mongodb://mood_user:cambiame@mongo:27017/mood_db?authSource=admin
MONGO_DB_NAME=mood_db

# Frontend / CORS
FRONTEND_URL=http://localhost
# CORS_ORIGINS=https://tudominio.com

# Google OAuth
GOOGLE_CLIENT_ID=

# SMTP (notificaciones por email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Gemini
GEMINI_API_KEY=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Opcionales
ENABLE_DOCS=0
SEND_EMAIL_REMINDERS=1
